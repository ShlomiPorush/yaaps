{
  "name": "@yaaps/server",
  "version": "1.3.0",
  "private": true,
  "description": "YAAPS HTTP server.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../plugins/yaaps/distribution/build-skill-distribution.mjs",
    "dev": "tsx watch src/index.ts",
    "pretypecheck": "npm run build --workspace @yaaps/contracts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@simplewebauthn/server": "13.3.2",
    "@yaaps/contracts": "*",
    "better-sqlite3": "13.0.3",
    "css-tree": "3.2.1",
    "fastify": "5.12.1",
    "kysely": "0.29.5",
    "parse5": "8.0.1",
    "parse5-sax-parser": "8.0.0",
    "redoc": "2.5.3",
    "swagger-ui-dist": "5.32.14",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/css-tree": "3.2.0",
    "tsx": "4.23.12"
  }
}
