# Production Compose inputs. Copy to an untracked .env only on an authorized host.
YAAPS_HOSTNAME=yaaps.net
YAAPS_PUBLIC_ORIGIN=https://yaaps.net
YAAPS_RP_ID=yaaps.net
YAAPS_MIN_TTL_SECONDS=3600
YAAPS_DEFAULT_TTL_SECONDS=604800
YAAPS_MAX_TTL_SECONDS=2592000
YAAPS_CLEANUP_INTERVAL_SECONDS=300

# Which upstream addresses to trust for X-Forwarded-For so per-IP rate limiting
# keys on the real client instead of the proxy address. "uniquelocal" trusts the
# private ranges a Docker/Traefik network uses. Accepts a proxy-addr preset
# (loopback|linklocal|uniquelocal), a comma-separated subnet/IP list, or
# true/false. Leave unset (false) when the app is exposed directly with no proxy.
YAAPS_TRUST_PROXY=uniquelocal

# Allow anyone to create an account with a passkey. Leave false to keep the
# instance invitation-only.
YAAPS_OPEN_REGISTRATION=true

# Generate a random value of at least 32 characters for first-run bootstrap.
# Remove it from the environment after the first administrator is registered.
YAAPS_BOOTSTRAP_SECRET=